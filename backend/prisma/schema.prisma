generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  ru
  en
  uz
}

enum UserRole {
  ADMIN
  MANAGER
  CUSTOMER
  PARTNER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum PartnerType {
  AGENCY
  OPERATOR
  TRANSPORT
  HOTEL
  OTHER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TourType {
  ONE_DAY
  SHORT
  MULTI_DAY
  GROUP
  PRIVATE
  MICE
}

enum Season {
  WINTER
  SPRING
  SUMMER
  AUTUMN
  ALL_YEAR
}

enum LeadType {
  GENERAL
  TOUR
  SERVICE
  NEWS
  COUNTRY
  PARTNER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUALIFIED
  WON
  LOST
  SPAM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AudienceType {
  B2C
  B2B
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  email           String            @unique
  passwordHash    String
  refreshTokenHash String?
  firstName       String
  lastName        String
  phone           String?
  role            UserRole          @default(CUSTOMER)
  status          UserStatus        @default(PENDING)
  preferredLocale Locale            @default(ru)
  partnerId       String?           @db.Uuid
  partner         Partner?          @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  translations    UserTranslation[]
  adminAuditLogs  AdminAuditLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([partnerId])
  @@index([role, status])
}

model UserTranslation {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  locale      Locale
  displayName String
  bio         String? @db.Text
  notes       String? @db.Text
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locale])
  @@index([locale])
}

model Partner {
  id              String               @id @default(uuid()) @db.Uuid
  slug            String               @unique
  type            PartnerType
  email           String?
  phone           String?
  managerPhone    String?
  website         String?
  city            String?
  tin             String?              @unique
  isActive        Boolean              @default(true)
  preferredLocale Locale               @default(ru)
  users           User[]
  leads           Lead[]
  bookings        Booking[]
  translations    PartnerTranslation[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([type, isActive])
}

model PartnerTranslation {
  id             String  @id @default(uuid()) @db.Uuid
  partnerId      String  @db.Uuid
  locale         Locale
  name           String
  description    String? @db.Text
  contactTitle   String?
  submitLabel    String?
  partner        Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, locale])
  @@index([locale])
}

model Country {
  id              String               @id @default(uuid()) @db.Uuid
  slug            String               @unique
  isoCode         String?              @unique
  heroImage       String?
  heroImageSettings Json?
  flagImage       String?
  sortOrder       Int                  @default(0)
  isFeatured      Boolean              @default(false)
  status          ContentStatus        @default(DRAFT)
  preferredLocale Locale               @default(ru)
  tours           Tour[]
  leads           Lead[]
  bookings        Booking[]
  translations    CountryTranslation[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, isFeatured, sortOrder])
}

model CountryTranslation {
  id            String  @id @default(uuid()) @db.Uuid
  countryId     String  @db.Uuid
  locale        Locale
  name          String
  welcomeTitle  String?
  intro         String? @db.Text
  sidebarTitle  String?
  cities        Json?
  toc           Json?
  sections      Json?
  seoTitle      String?
  seoDescription String? @db.Text
  country       Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, locale])
  @@index([locale])
}

model Tour {
  id                String            @id @default(uuid()) @db.Uuid
  countryId         String            @db.Uuid
  slug              String            @unique
  type              TourType
  season            Season            @default(ALL_YEAR)
  heroImage         String?
  mainImage         String?
  mainImageSettings Json?
  routeMapImage     String?
  routeMapImageSettings Json?
  durationDays      Int
  durationNights    Int
  minGroupSize      Int?
  maxGroupSize      Int?
  comfortLevel      Int?
  priceFrom         Decimal?          @db.Decimal(10, 2)
  currency          String?           @default("USD")
  incomingTourId    String?
  incomingHotelCode String?
  incomingHotelName String?
  isFeatured        Boolean           @default(false)
  sortOrder         Int               @default(0)
  showPriceToB2C    Boolean           @default(false)
  status            ContentStatus     @default(DRAFT)
  country           Country           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  days              TourDay[]
  images            TourImage[]
  leads             Lead[]
  bookings          Booking[]
  translations      TourTranslation[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([countryId])
  @@index([status, isFeatured])
  @@index([status, isFeatured, sortOrder])
  @@index([type, season])
}

model TourTranslation {
  id                 String  @id @default(uuid()) @db.Uuid
  tourId             String  @db.Uuid
  locale             Locale
  title              String
  subtitle           String?
  route              String
  description        String  @db.Text
  hotelsInfo         String? @db.Text
  transportInfo      String? @db.Text
  countriesInfo      String? @db.Text
  detailsInfo        String? @db.Text
  routesInfo         String? @db.Text
  reviewsInfo        String? @db.Text
  included           Json?
  excluded           Json?
  localizedSlug      String?
  seoTitle           String?
  seoDescription     String? @db.Text
  tour               Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, locale])
  @@index([locale])
}

model TourDay {
  id           String               @id @default(uuid()) @db.Uuid
  tourId       String               @db.Uuid
  dayNumber    Int
  overnightAt  String?
  image        String?
  translations TourDayTranslation[]
  tour         Tour                 @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([tourId, dayNumber])
  @@index([tourId])
}

model TourDayTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  tourDayId   String  @db.Uuid
  locale      Locale
  title       String
  shortTitle  String?
  description String  @db.Text
  inclusions  Json?
  tourDay     TourDay @relation(fields: [tourDayId], references: [id], onDelete: Cascade)

  @@unique([tourDayId, locale])
  @@index([locale])
}

model TourImage {
  id           String                 @id @default(uuid()) @db.Uuid
  tourId       String                 @db.Uuid
  imageUrl     String
  sortOrder    Int                    @default(0)
  isCover      Boolean                @default(false)
  translations TourImageTranslation[]
  tour         Tour                   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([tourId, sortOrder])
}

model TourImageTranslation {
  id         String    @id @default(uuid()) @db.Uuid
  tourImageId String   @db.Uuid
  locale     Locale
  altText    String
  caption    String?   @db.Text
  tourImage  TourImage @relation(fields: [tourImageId], references: [id], onDelete: Cascade)

  @@unique([tourImageId, locale])
  @@index([locale])
}

model Service {
  id              String               @id @default(uuid()) @db.Uuid
  slug            String               @unique
  heroImage       String?
  previewImage    String?
  previewImageSettings Json?
  sortOrder       Int                  @default(0)
  isFeatured      Boolean              @default(false)
  leadFormEnabled Boolean              @default(true)
  status          ContentStatus        @default(DRAFT)
  leads           Lead[]
  translations    ServiceTranslation[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, isFeatured, sortOrder])
}

model ServiceTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  serviceId        String   @db.Uuid
  locale           Locale
  name             String
  title            String?
  subtitle         String?  @db.Text
  shortDescription String?  @db.Text
  content          Json?
  localizedSlug    String?
  seoTitle         String?
  seoDescription   String?  @db.Text
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale])
}

model HomeBanner {
  id           String                  @id @default(uuid()) @db.Uuid
  slug         String                  @unique
  imageUrl     String
  imageSettings Json?
  mobileImageUrl String?
  linkUrl      String?
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)
  translations HomeBannerTranslation[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([isActive, sortOrder])
}

model HomeBannerTranslation {
  id            String     @id @default(uuid()) @db.Uuid
  homeBannerId  String     @db.Uuid
  locale        Locale
  title         String
  subtitle      String?    @db.Text
  buttonLabel   String?
  altText       String?
  homeBanner    HomeBanner @relation(fields: [homeBannerId], references: [id], onDelete: Cascade)

  @@unique([homeBannerId, locale])
  @@index([locale])
}

model Page {
  id              String            @id @default(uuid()) @db.Uuid
  slug            String            @unique
  path            String            @unique
  status          ContentStatus     @default(DRAFT)
  sortOrder       Int               @default(0)
  translations    PageTranslation[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, sortOrder])
}

model PageTranslation {
  id             String  @id @default(uuid()) @db.Uuid
  pageId         String  @db.Uuid
  locale         Locale
  title          String
  menuLabel      String?
  heroTitle      String?
  heroSubtitle   String? @db.Text
  content        Json?
  seoTitle       String?
  seoDescription String? @db.Text
  page           Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([locale])
}

model SiteSetting {
  id              String                   @id @default(uuid()) @db.Uuid
  key             String                   @unique
  group           String                   @default("general")
  value           Json?
  isPublic        Boolean                  @default(true)
  translations    SiteSettingTranslation[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([group, isPublic])
}

model SiteSettingTranslation {
  id            String      @id @default(uuid()) @db.Uuid
  siteSettingId String      @db.Uuid
  locale        Locale
  label         String
  textValue     String?     @db.Text
  description   String?     @db.Text
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)

  @@unique([siteSettingId, locale])
  @@index([locale])
}

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  fileName  String
  url       String
  mimeType  String?
  altText   String?
  group     String?  @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

model News {
  id              String            @id @default(uuid()) @db.Uuid
  slug            String            @unique
  heroImage       String?
  previewImage    String?
  previewImageSettings Json?
  publishedAt     DateTime?
  status          ContentStatus     @default(DRAFT)
  syncToB2B       Boolean           @default(true)
  syncToB2C       Boolean           @default(true)
  leads           Lead[]
  translations    NewsTranslation[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, publishedAt])
}

model NewsTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  newsId         String   @db.Uuid
  locale         Locale
  title          String
  excerpt        String?  @db.Text
  content        Json?
  localizedSlug  String?
  seoTitle       String?
  seoDescription String?  @db.Text
  news           News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, locale])
  @@index([locale])
}

model WhyCategory {
  id              String                  @id @default(uuid()) @db.Uuid
  slug            String                  @unique
  sortOrder       Int                     @default(0)
  status          ContentStatus           @default(DRAFT)
  heroImage       String?
  heroImageSettings Json?
  facts           WhyFact[]
  translations    WhyCategoryTranslation[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([status, sortOrder])
}

model WhyCategoryTranslation {
  id             String      @id @default(uuid()) @db.Uuid
  whyCategoryId  String      @db.Uuid
  locale         Locale
  title          String
  subtitle       String?
  description    String?     @db.Text
  seoTitle       String?
  seoDescription String?     @db.Text
  whyCategory    WhyCategory @relation(fields: [whyCategoryId], references: [id], onDelete: Cascade)

  @@unique([whyCategoryId, locale])
  @@index([locale])
}

model WhyFact {
  id              String              @id @default(uuid()) @db.Uuid
  whyCategoryId   String              @db.Uuid
  sortOrder       Int                 @default(0)
  imageUrl        String?
  imageSettings   Json?
  status          ContentStatus       @default(DRAFT)
  whyCategory     WhyCategory         @relation(fields: [whyCategoryId], references: [id], onDelete: Cascade)
  translations    WhyFactTranslation[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([whyCategoryId, sortOrder])
  @@index([status])
}

model WhyFactTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  whyFactId      String   @db.Uuid
  locale         Locale
  title          String
  subtitle       String?
  description    String   @db.Text
  whyFact        WhyFact  @relation(fields: [whyFactId], references: [id], onDelete: Cascade)

  @@unique([whyFactId, locale])
  @@index([locale])
}

model Lead {
  id              String            @id @default(uuid()) @db.Uuid
  type            LeadType
  status          LeadStatus        @default(NEW)
  audience        AudienceType      @default(B2C)
  locale          Locale            @default(ru)
  name            String
  email           String
  phone           String?
  company         String?
  sourcePagePath  String?
  sourcePageTitle String?
  countryId       String?           @db.Uuid
  tourId          String?           @db.Uuid
  serviceId       String?           @db.Uuid
  newsId          String?           @db.Uuid
  partnerId       String?           @db.Uuid
  metadata        Json?
  country         Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  tour            Tour?             @relation(fields: [tourId], references: [id], onDelete: SetNull)
  service         Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  news            News?             @relation(fields: [newsId], references: [id], onDelete: SetNull)
  partner         Partner?          @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  translations    LeadTranslation[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, type, audience])
  @@index([countryId])
  @@index([tourId])
  @@index([serviceId])
  @@index([newsId])
  @@index([partnerId])
}

model LeadTranslation {
  id          String @id @default(uuid()) @db.Uuid
  leadId      String @db.Uuid
  locale      Locale
  subject     String?
  message     String? @db.Text
  formTitle   String?
  submitLabel String?
  lead        Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, locale])
  @@index([locale])
}

model Booking {
  id                      String               @id @default(uuid()) @db.Uuid
  bookingNumber           String               @unique
  status                  BookingStatus        @default(PENDING)
  audience                AudienceType         @default(B2B)
  locale                  Locale               @default(ru)
  tourId                  String?              @db.Uuid
  partnerId               String?              @db.Uuid
  countryId               String?              @db.Uuid
  firstName               String
  lastName                String
  sex                     String?
  birthDate               DateTime?
  phone                   String?
  email                   String
  nationality             String?
  documentType            String?
  documentSeries          String?
  documentNumber          String?
  documentIssuedAt        DateTime?
  documentValidUntil      DateTime?
  travelDate              DateTime?
  groupSize               Int?
  hotelName               String?
  totalPrice              Decimal?             @db.Decimal(10, 2)
  currency                String?              @default("USD")
  sourcePagePath          String?
  includedServicesSnapshot Json?
  metadata                Json?
  tour                    Tour?                @relation(fields: [tourId], references: [id], onDelete: SetNull)
  partner                 Partner?             @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  country                 Country?             @relation(fields: [countryId], references: [id], onDelete: SetNull)
  translations            BookingTranslation[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([status, audience])
  @@index([tourId])
  @@index([partnerId])
  @@index([countryId])
}

model BookingTranslation {
  id               String  @id @default(uuid()) @db.Uuid
  bookingId        String  @db.Uuid
  locale           Locale
  packageTitle     String?
  packageSummary   String? @db.Text
  specialRequests  String? @db.Text
  internalNotes    String? @db.Text
  booking          Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, locale])
  @@index([locale])
}

model AdminAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  userEmail      String?
  userRole       UserRole?
  action         String
  entityType     String
  entityId       String?
  entityTitle    String?
  method         String?
  path           String?
  ip             String?
  userAgent      String?  @db.Text
  metadata       Json?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entityType])
}
